# Environment Configuration
# Copy this file to .env and fill in actual values.

# Database
DATABASE_URL=postgresql://ai_civilization:changeme@postgres:5432/ai_civilization
DATABASE_PASSWORD=changeme

# Minecraft Plugin API
MINECRAFT_API_KEY=changeme
MINECRAFT_HOST=minecraft
MINECRAFT_PORT=25565

# AI Controller
AI_CONTROLLER_API_KEY=changeme
AI_CONTROLLER_HOST=0.0.0.0
AI_CONTROLLER_PORT=8000

# AI Inference
AI_INFERENCE_API_KEY=changeme
AI_INFERENCE_HOST=0.0.0.0
AI_INFERENCE_PORT=8001
FAST_MODEL_PATH=/models/fast-model.gguf
MAIN_MODEL_PATH=/models/main-model.gguf
FAST_MODEL_CONTEXT_SIZE=2048
MAIN_MODEL_CONTEXT_SIZE=4096

# Experiment
EXPERIMENT_ID=experiment_001
INITIAL_POPULATION=1000
MAX_POPULATION=10000
